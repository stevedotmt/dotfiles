[color]
  pager = true
  ui = auto
  status = auto
  diff = auto
  branch = auto
  showBranch = auto
  interactive = auto
  grep = auto
[color "status"]
  header = black bold
  branch = cyan
  nobranch = red
  unmerged = red
  untracked = cyan
  added = green
  changed = red bold
[color "diff"]
  meta = red bold
  frag = black bold
  func = blue
  old = red strike
  new = green
  commit = blue
  whitespace = red
  context = normal
[color "branch"]
  current = cyan
  local = blue
  remote = magenta
  upstream = magenta
  plain = normal
[color "decorate"]
  branch = blue
  remoteBranch = magenta
  tag = magenta
  stash = cyan
  HEAD = blue
[color "interactive"]
  prompt = red
  header = red bold
  error = red
  help = black bold
[color "grep"]
  context = normal
  match = cyan
  filename = blue
  function = blue
  selected = normal
  separator = red bold
  linenumber = normal
[core]
  editor = nvim
  autocrlf = input
  pager = delta
[pull]
  rebase = true
[push]
  autoSetupRemote = true
[alias]
  mr = !sh -c 'git fetch $1 merge-requests/$2/head:mr-$1-$2 && git checkout mr-$1-$2' -
  pr = !sh -c 'git fetch $1 pull/$2/head:pr-$1-$2 && git checkout pr-$1-$2' -
[protocol]
  version = 2
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[gpg]
  format = ssh
[commit]
  gpgsign = true
  verbose = true
[tag]
  gpgsign = true
[init]
  defaultBranch = main
[credential]
  helper =
[branch]
  sort = -committerdate
[includeIf "gitdir:/"]
  path = ~/.gitconfig-mbp
[rebase]
  updateRefs = true
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  light = true
  syntax-theme = Mies Light
  minus-style = syntax "#F8E6E6"
  minus-non-emph-style = syntax "#F8E6E6"
  minus-emph-style = syntax "#F2CCCC"
  minus-empty-line-marker-style = normal "#F8E6E6"
  plus-style = syntax "#E6F2E6"
  plus-non-emph-style = syntax "#E6F2E6"
  plus-emph-style = syntax "#D4EAD4"
  plus-empty-line-marker-style = normal "#E6F2E6"
  file-style = "#080808" bold
  file-decoration-style = "#949494" ul
  hunk-header-style = file line-number syntax
  hunk-header-decoration-style = "#C6C6C6" box
  hunk-header-file-style = "#5F8787"
  hunk-header-line-number-style = "#767676"
  line-numbers-minus-style = "#D70000"
  line-numbers-plus-style = "#008700"
  line-numbers-zero-style = "#767676"
  line-numbers-left-style = "#C6C6C6"
  line-numbers-right-style = "#C6C6C6"
  commit-style = "#5F8787"
  commit-decoration-style = "#C6C6C6" box
  blame-palette = "#FFFFFF" "#F2F2F2" "#E4E4E4"
  whitespace-error-style = "#D70000" reverse
[merge]
    conflictStyle = zdiff3
